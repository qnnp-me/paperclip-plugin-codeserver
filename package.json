{
  "name": "@qnnp/paperclip-plugin-codeserver",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Embed code-server (VS Code Web) inside Paperclip: a Code entry per task/project workspace, a side-panel tab, and a configurable cs-gate autologin ticket.",
  "license": "MIT",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "pretest": "node ./esbuild.config.mjs",
    "test": "node --test test/config.test.mjs test/urls.test.mjs test/gate.test.mjs test/workspace.test.mjs test/workspace.harness.test.mjs test/ui.render.test.mjs test/overlay.history.test.mjs"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.1106.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "code-server",
    "vscode",
    "workspace"
  ],
  "homepage": "https://github.com/qnnp-me/paperclip-plugin-codeserver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qnnp-me/paperclip-plugin-codeserver.git"
  },
  "bugs": {
    "url": "https://github.com/qnnp-me/paperclip-plugin-codeserver/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
