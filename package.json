{
  "name": "@qnnp/paperclip-plugin-codeserver",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Embed code-server inside Paperclip: a Code button on every task/project that opens its own workspace folder, a page slot, a top-bar entry, and a classic-interface tab.",
  "license": "MIT",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "node --test test/urls.test.mjs test/workspace.test.mjs test/workspace.harness.test.mjs test/ui.render.test.mjs"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.1106.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
